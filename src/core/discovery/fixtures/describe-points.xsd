<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:gml="http://www.opengis.net/gml/3.2" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:topp="http://www.openplans.org/topp" targetNamespace="http://www.openplans.org/topp">
  <xs:complexType name="pointsType">
    <xs:complexContent>
      <xs:extension base="gml:AbstractFeatureType">
        <xs:sequence>
          <xs:element name="geom" type="gml:GeometryPropertyType" minOccurs="0"/>
          <xs:element name="name" type="xs:normalizedString" nillable="false"/>
          <xs:element name="code" type="xs:token"/>
          <xs:element name="link" type="xs:anyURI"/>
          <xs:element name="count" type="xs:int"/>
          <xs:element name="big" type="xs:long"/>
          <xs:element name="small" type="xs:short"/>
          <xs:element name="tiny" type="xs:byte"/>
          <xs:element name="pos" type="xs:positiveInteger"/>
          <xs:element name="uns" type="xs:unsignedInt"/>
          <xs:element name="ratio" type="xs:float"/>
          <xs:element name="price" type="xs:decimal"/>
          <xs:element name="flag" type="xs:boolean"/>
          <xs:element name="day" type="xs:date"/>
          <xs:element name="stamp" type="xs:dateTime"/>
          <xs:element name="clock" type="xs:time"/>
          <xs:element name="odd" type="topp:customType"/>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:element name="points" type="topp:pointsType" substitutionGroup="gml:AbstractFeature"/>
</xs:schema>
