{
  "name": "ol-cad",
  "version": "0.0.0",
  "description": "CAD-style drawing and editing tools for OpenLayers, framework-agnostic",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=22.6",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@10.12.1",
  "files": [
    "dist",
    "!dist/**/*.test.d.ts",
    "CHANGELOG.md"
  ],
  "main": "./dist/ol-cad.umd.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui.js",
      "default": "./dist/ui.js"
    },
    "./ui.css": "./dist/ui.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "vite --open /examples/",
    "serve:test": "node test-server/server.ts",
    "start:test": "sh scripts/start-test-system.sh",
    "build": "pnpm build:esm && pnpm build:umd",
    "build:esm": "vite build",
    "build:umd": "BUILD_TARGET=umd vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write ."
  },
  "peerDependencies": {
    "ol": ">=9 <11",
    "proj4": "^2"
  },
  "peerDependenciesMeta": {
    "proj4": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "ol": "^10.11.0",
    "prettier": "^3.9.9",
    "proj4": "^2.22.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.3"
  }
}
