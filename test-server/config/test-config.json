{
  "target": "map",
  "editMode": false,
  "changes": {
    "precision": 7,
    "fullFeatures": false
  },
  "locale": "en",
  "messages": {},
  "snapping": {
    "enabled": true,
    "tolerancePx": 12,
    "modes": ["vertex", "midpoint", "perpendicular", "tangent"]
  },
  "grid": {
    "enabled": false,
    "spacing": 5,
    "origin": [0, 0],
    "visible": true
  },
  "curves": {
    "tolerance": 0.01
  },
  "units": {
    "length": "auto"
  },
  "constraints": {
    "angle": {
      "enabled": false,
      "step": 90
    }
  },
  "draft": {
    "enabled": true,
    "id": "draft",
    "title": "Draft",
    "style": {
      "circle-radius": 5,
      "circle-fill-color": "#f59e0b",
      "circle-stroke-color": "#1b1e24",
      "circle-stroke-width": 1.5,
      "stroke-color": "#f59e0b",
      "stroke-width": 2,
      "stroke-line-dash": [6, 4],
      "fill-color": "rgba(245, 158, 11, 0.15)"
    }
  },
  "selection": {
    "strokeColor": "#22d3ee",
    "strokeWidth": 3,
    "fillColor": "rgba(34, 211, 238, 0.15)",
    "pointRadius": 8,
    "haloColor": "rgba(255, 255, 255, 0.6)",
    "haloWidth": 3,
    "vertexSize": 6,
    "inspect": true
  },
  "layerHighlight": {
    "strokeColor": "#f59e0b",
    "strokeWidth": 3,
    "fillColor": "rgba(245, 158, 11, 0.2)",
    "pointRadius": 7
  },
  "cursor": {
    "crosshair": true,
    "pickBoxSize": 8,
    "color": "#f3f4f6",
    "pickColor": "#facc15",
    "angle": 0
  },
  "view": {
    "projection": "EPSG:3857",
    "center": [935100, 6276400],
    "zoom": 16,
    "minZoom": 2,
    "maxZoom": 22,
    "rotation": 0
  },
  "projections": [
    {
      "code": "EPSG:25832",
      "title": "UTM 32N",
      "def": "+proj=utm +zone=32 +ellps=GRS80 +towgs84=0,0,0,0,0,0,0 +units=m +no_defs"
    }
  ],
  "basemaps": [
    {
      "id": "osm",
      "type": "osm",
      "title": "OpenStreetMap",
      "maxZoom": 19
    },
    {
      "id": "versatiles-dark",
      "type": "vector-tile",
      "title": "VersaTiles dark (vector tiles)",
      "url": "https://tiles.versatiles.org/tiles/osm/{z}/{x}/{y}",
      "format": "mvt",
      "minZoom": 0,
      "maxZoom": 14,
      "projection": "EPSG:3857",
      "attribution": "&copy; OpenStreetMap contributors, VersaTiles",
      "style": [
        {
          "filter": ["in", ["get", "layer"], ["literal", ["ocean", "water_polygons"]]],
          "style": {
            "fill-color": "#1a2634"
          }
        },
        {
          "filter": ["in", ["get", "layer"], ["literal", ["land", "sites"]]],
          "style": {
            "fill-color": "#23262c"
          }
        },
        {
          "filter": ["in", ["get", "layer"], ["literal", ["street_polygons", "public_transport"]]],
          "style": {
            "fill-color": "#2a2d34"
          }
        },
        {
          "filter": ["==", ["get", "layer"], "buildings"],
          "style": {
            "fill-color": "#30343c"
          }
        },
        {
          "filter": ["==", ["get", "layer"], "water_lines"],
          "style": {
            "stroke-color": "#2b445c",
            "stroke-width": 0.8
          }
        },
        {
          "filter": ["==", ["get", "layer"], "streets"],
          "style": {
            "stroke-color": "#4a4f58",
            "stroke-width": 0.8
          }
        },
        {
          "filter": ["in", ["get", "layer"], ["literal", ["bridges", "pier_lines", "dam_lines"]]],
          "style": {
            "stroke-color": "#3d414a",
            "stroke-width": 0.8
          }
        },
        {
          "filter": ["==", ["get", "layer"], "boundaries"],
          "style": {
            "stroke-color": "#5a5f6a",
            "stroke-width": 0.6
          }
        }
      ],
      "visible": true
    },
    {
      "id": "opentopomap",
      "type": "xyz",
      "title": "OpenTopoMap",
      "url": "https://{a-c}.tile.opentopomap.org/{z}/{x}/{y}.png",
      "attribution": "Map data &copy; <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap</a> contributors, SRTM | Map style &copy; <a href=\"https://opentopomap.org/\">OpenTopoMap</a> (CC-BY-SA)",
      "minZoom": 0,
      "maxZoom": 17,
      "tileSize": 256,
      "crossOrigin": "anonymous"
    },
    {
      "id": "osm-wms",
      "type": "wms",
      "title": "OSM WMS tiled (terrestris)",
      "url": "https://ows.terrestris.de/osm/service",
      "params": {
        "LAYERS": "OSM-WMS",
        "FORMAT": "image/png",
        "TRANSPARENT": false,
        "VERSION": "1.3.0"
      },
      "tiled": true,
      "serverType": "geoserver",
      "crossOrigin": "anonymous",
      "attribution": "&copy; terrestris, OpenStreetMap contributors"
    },
    {
      "id": "osm-wms-image",
      "type": "wms",
      "title": "OSM WMS single image",
      "url": "https://ows.terrestris.de/osm/service",
      "params": {
        "LAYERS": "OSM-WMS"
      },
      "tiled": false,
      "projection": "EPSG:3857"
    },
    {
      "id": "topplus",
      "type": "wmts",
      "title": "TopPlusOpen (BKG)",
      "capabilitiesUrl": "https://sgx.geodatenzentrum.de/wmts_topplus_open/1.0.0/WMTSCapabilities.xml",
      "layer": "web",
      "format": "image/png",
      "style": "default",
      "crossOrigin": "anonymous",
      "attribution": "&copy; GeoBasis-DE / BKG, CC BY 4.0"
    },
    {
      "id": "s2cloudless",
      "type": "geotiff",
      "title": "Sentinel-2 true colour (COG, Red Sea)",
      "sources": [
        {
          "url": "https://sentinel-cogs.s3.us-west-2.amazonaws.com/sentinel-s2-l2a-cogs/36/Q/WD/2020/7/S2A_36QWD_20200701_0_L2A/TCI.tif",
          "bands": [1, 2, 3],
          "min": 0,
          "max": 255,
          "nodata": 0
        }
      ],
      "normalize": true,
      "convertToRGB": false,
      "attribution": "Contains modified Copernicus Sentinel data 2020"
    }
  ]
}
