{
  "layers": [
    {
      "id": "parcels",
      "title": "Parcels",
      "attribution": "Parcels &copy; ol-cad test data",
      "legendUrl": "/wms?SERVICE=WMS&REQUEST=GetLegendGraphic&FORMAT=image/png&LAYER=test:parcels",
      "extent": [8.3988, 49.0089, 8.4032, 49.0106],
      "visible": true,
      "source": {
        "format": "geojson",
        "url": "/data/parcels.geojson",
        "dataProjection": "EPSG:4326",
        "strategy": "all"
      },
      "geometryType": "Polygon",
      "idProperty": "id",
      "editable": {
        "insert": true,
        "update": true,
        "delete": false
      },
      "snappable": true,
      "style": {
        "stroke-color": "#b45309",
        "stroke-width": 2,
        "fill-color": "rgba(245, 158, 11, 0.2)"
      },
      "schema": {
        "fields": [
          {
            "name": "owner",
            "type": "string",
            "label": "Owner",
            "required": true,
            "pattern": "^[A-Za-z .'-]+$"
          },
          {
            "name": "usage",
            "type": "enum",
            "values": ["residential", "commercial", "public"],
            "default": "residential"
          },
          {
            "name": "area_m2",
            "type": "number",
            "readOnly": true,
            "min": 0
          },
          {
            "name": "floors",
            "type": "integer",
            "min": 0,
            "max": 50,
            "default": 1
          },
          {
            "name": "protected",
            "type": "boolean",
            "default": false
          },
          {
            "name": "surveyed",
            "type": "date",
            "label": "Surveyed on"
          }
        ]
      },
      "minZoom": 8,
      "maxZoom": 24
    },
    {
      "id": "roads",
      "title": "Roads",
      "source": {
        "format": "geojson",
        "url": "/data/roads.geojson"
      },
      "geometryType": "LineString",
      "idProperty": "id",
      "editable": true,
      "schema": {
        "fields": [
          {
            "name": "name",
            "type": "string",
            "required": true
          },
          {
            "name": "lanes",
            "type": "integer",
            "min": 1,
            "max": 8,
            "default": 2
          }
        ]
      }
    },
    {
      "id": "hydrants",
      "title": "Hydrants (KML)",
      "source": {
        "format": "kml",
        "url": "/data/hydrants.kml"
      },
      "geometryType": "Point",
      "idProperty": "id",
      "editable": {
        "insert": true
      },
      "schema": {
        "fields": [
          {
            "name": "pressure",
            "type": "number",
            "min": 0,
            "max": 16
          }
        ]
      }
    },
    {
      "id": "tracks",
      "title": "Tracks (GPX, read-only)",
      "source": {
        "format": "gpx",
        "url": "/data/tracks.gpx"
      },
      "geometryType": "MultiLineString",
      "editable": false,
      "snappable": false
    },
    {
      "id": "buildings",
      "title": "Buildings (TopoJSON)",
      "opacity": 0.6,
      "source": {
        "format": "topojson",
        "url": "/data/buildings.topojson"
      },
      "geometryType": "MultiPolygon",
      "editable": {
        "update": true,
        "delete": true
      },
      "style": {
        "stroke-color": "#4b5563",
        "stroke-width": 1,
        "fill-color": "rgba(75, 85, 99, 0.35)"
      }
    },
    {
      "id": "survey-points",
      "title": "Survey points (WKT, EPSG:25832)",
      "extent": [456084, 5428742, 456200, 5428795],
      "extentProjection": "EPSG:25832",
      "source": {
        "format": "wkt",
        "data": "MULTIPOINT((456094.22 5428752.20),(456189.55 5428784.79))",
        "dataProjection": "EPSG:25832"
      },
      "geometryType": "MultiPoint",
      "editable": {
        "update": true
      }
    },
    {
      "id": "trees",
      "title": "Trees (GML 3, EPSG:25832)",
      "source": {
        "format": "gml",
        "url": "/data/trees.gml",
        "gmlVersion": "3"
      },
      "geometryType": "Point",
      "idProperty": "id",
      "editable": false,
      "style": {
        "circle-radius": 6,
        "circle-fill-color": "#15803d"
      }
    },
    {
      "id": "lamps",
      "title": "Lamps (WFS)",
      "source": {
        "format": "wfs",
        "url": "/wfs",
        "typeName": "lamps",
        "version": "1.1.0",
        "outputFormat": "application/json",
        "strategy": "bbox",
        "params": { "maxFeatures": 500 },
        "fetch": { "credentials": "same-origin" }
      },
      "geometryType": "Point",
      "idProperty": "id",
      "editable": true,
      "style": {
        "circle-radius": 5,
        "circle-fill-color": "#facc15",
        "circle-stroke-color": "#713f12",
        "circle-stroke-width": 1
      }
    },
    {
      "id": "points-wfs",
      "title": "Points (WFS 2.0.0, paged)",
      "visible": false,
      "snappable": false,
      "source": {
        "format": "wfs",
        "url": "/wfs",
        "typeName": "points",
        "version": "2.0.0",
        "outputFormat": "application/json",
        "strategy": "all",
        "pageSize": 20,
        "params": { "sortBy": "id" }
      },
      "geometryType": "Point",
      "idProperty": "id",
      "editable": false,
      "schema": {
        "fields": [
          { "name": "id", "type": "integer", "readOnly": true },
          { "name": "kind", "type": "enum", "values": ["hydrant", "lamp", "bench"] }
        ]
      },
      "style": {
        "circle-radius": 3,
        "circle-fill-color": "#a3e635",
        "circle-stroke-color": "#365314",
        "circle-stroke-width": 1
      }
    },
    {
      "id": "labels",
      "title": "Labels",
      "source": {
        "format": "geojson",
        "url": "/data/labels.geojson"
      },
      "geometryType": "Point",
      "idProperty": "id",
      "editable": true,
      "text": {
        "height": 5,
        "color": "#fef3c7",
        "haloColor": "rgba(17, 24, 39, 0.85)",
        "font": "system-ui, sans-serif",
        "property": "text",
        "heightProperty": "textHeight",
        "rotationProperty": "textRotation"
      },
      "schema": {
        "fields": [
          {
            "name": "text",
            "type": "string",
            "required": true,
            "label": "Text"
          },
          {
            "name": "textHeight",
            "type": "number",
            "min": 0.1,
            "label": "Height (m)"
          },
          {
            "name": "textRotation",
            "type": "number",
            "label": "Rotation (\u00b0)"
          }
        ]
      }
    },
    {
      "id": "dimensions",
      "title": "Dimensions",
      "source": {
        "format": "geojson",
        "url": "/data/dimensions.geojson"
      },
      "geometryType": "LineString",
      "idProperty": "id",
      "editable": true,
      "snappable": false,
      "dimension": {
        "preset": "architecture",
        "referenceScale": 2500,
        "textSize": 3.5,
        "terminator": "tick",
        "tolerance": 0.05,
        "showComputed": "plain",
        "color": "#fde68a",
        "computedColor": "#9ca3af",
        "deviationColor": "#f87171",
        "font": "system-ui, sans-serif",
        "angleUnit": "deg",
        "angleTolerance": 0.2,
        "associative": false
      },
      "schema": {
        "fields": [
          {
            "name": "offset",
            "type": "number",
            "label": "Offset (m)"
          }
        ]
      }
    }
  ]
}
